<?xml version="1.0"?>
<!-- Componente "centro_cnc" de la biblioteca del contrato 2.0. Origen = centro geométrico. -->
<robot name="centro_cnc">
  <link name="centro_cnc">
    <visual><geometry><box size="0.3 0.5 0.4"/></geometry></visual>
    <collision><geometry><box size="0.3 0.5 0.4"/></geometry></collision>
  </link>
</robot>
