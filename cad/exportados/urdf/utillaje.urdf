<?xml version="1.0"?>
<!-- Componente "utillaje" de la biblioteca del contrato 2.0. Origen = centro geométrico. -->
<robot name="utillaje">
  <link name="utillaje">
    <visual><geometry><box size="0.13 0.13 0.16"/></geometry></visual>
    <collision><geometry><box size="0.13 0.13 0.16"/></geometry></collision>
  </link>
</robot>
