<?xml version="1.0"?>
<!-- Componente "cilindro" de la biblioteca del contrato 2.0. Origen = centro geométrico. -->
<robot name="cilindro">
  <link name="cilindro">
    <visual><geometry><cylinder radius="0.0451" length="0.16"/></geometry></visual>
    <collision><geometry><cylinder radius="0.0451" length="0.16"/></geometry></collision>
  </link>
</robot>
